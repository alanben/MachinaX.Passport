<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>XXBoom.MachinaX.PassportX</RootNamespace>
		<AssemblyName>XXBoom.MachinaX.PassportX</AssemblyName>

		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<Version>$(AssemblyVersion)</Version>

		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsPublishable>False</IsPublishable>
		<Title>PassportX library</Title>
		<Version>$(AssemblyVersion)</Version>
		<Authors>alanben</Authors>
		<Company>XXBoom</Company>
		<Description>PassportX classes and enums</Description>
		<Copyright>Alan Benington</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/alanben/MachinaX.Passport</RepositoryUrl>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="log4net" Version="2.0.15" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="XXBoom.MachinaX" Version="2.0.8" />
		<PackageReference Include="XXBoom.MachinaX.DataX" Version="2.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Web.Services" />
	</ItemGroup>

</Project>
